# Backend (transit-simulator-backend) secrets — not read by the frontend.
VVS_TRIAS_API_KEY=

# Realtime backend base URL. In dev, Vite proxies /api to this target so the
# browser calls the same origin (the backend sends no CORS headers). In prod
# builds the browser calls this URL directly, so deploy behind a reverse proxy
# that serves /api or enable CORS on the backend.
VITE_REALTIME_API_BASE=http://localhost:8080

# Shows the "Live" entry point (real VVS vehicle traffic) in hosted builds.
# Always on in local dev regardless of this value. Set to "true" on the
# deployment (e.g. Vercel project env vars) once live mode is ready to ship.
VITE_ENABLE_LIVE=false
