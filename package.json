{
  "name": "stuttgart-stadtbahn-simulator",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "gen:api": "swagger-typescript-api generate -p ./api/openapi.yaml -o ./src/features/realtime/generated -n api-types.ts --no-client --enum-style=union --sort-types --clean-output",
    "build": "npm run wasm:build && tsc && vite build",
    "build:client": "tsc && vite build",
    "build:vercel": "test -s public/sim.wasm && test -s public/wasm_exec.js && npm run build:client",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:visual:live": "node scripts/visual-smoke.mjs --live",
    "test:visual:video": "node scripts/visual-smoke.mjs --video",
    "wasm:build": "bash scripts/build-wasm.sh"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "0.184.1",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.9.0",
    "swagger-typescript-api": "^13.12.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "^3.2.7"
  }
}
